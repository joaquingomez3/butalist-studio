---
interface Props {
  items: string[];
  speed?: string;
  className?: string;
  accent?: boolean;
  separator?: string;
}
const {
  items,
  speed = "36s",
  className = "text-[11vw]",
  accent = false,
  separator = "✦",
} = Astro.props;
---

<div
  class="select-none overflow-hidden whitespace-nowrap border-y border-rule py-4"
  style={`--marquee-speed: ${speed}`}
  aria-hidden="true"
>
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div
        class={`flex shrink-0 items-center ${accent ? "text-accent" : "text-ink"}`}
      >
        {items.map((item) => (
          <span
            class={`px-6 font-display font-bold leading-none ${className} ${accent ? "text-outline-accent" : ""}`}
          >
            {item}
          </span>
        ))}
        <span class={`px-6 font-display font-bold leading-none text-ink-faint ${className}`}>
          {separator}
        </span>
      </div>
    ))}
  </div>
</div>