---
import { processSteps } from "../data/process";
---

<section id="proceso" class="border-t border-rule" data-process-section>
  <div class="relative flex h-screen flex-col">
    <div class="container-fx flex items-baseline justify-between py-6">
      <span class="label-accent">§05 / PROCESO</span>
      <span class="label hidden sm:inline">CÓMO TRABAJAMOS</span>
    </div>

    <div class="mx-auto w-full flex-1 px-5 sm:px-8 lg:px-12" style="max-width: 1400px">
      <div class="relative h-full overflow-hidden">
        {
          processSteps.map((step, i) => (
            <div
              class="absolute inset-0 flex flex-col justify-center"
              data-process-step={i}
              aria-hidden={i !== 0 ? "true" : undefined}
            >
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-sm text-accent">{step.number}</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-faint">
                  PASO {i + 1} / {processSteps.length}
                </span>
              </div>
              <h2 class="h-display mt-4 text-[clamp(2.4rem,7vw,6rem)] uppercase">{step.title}</h2>
              <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="container-fx flex items-center justify-between gap-6 border-t border-rule py-5">
      <span class="label hidden sm:inline">SCROLL PARA AVANZAR</span>
      <div class="h-1 flex-1 bg-rule">
        <div class="h-1 origin-left bg-accent" data-process-progress></div>
      </div>
      <span class="font-mono text-2xl font-bold text-accent" data-process-counter>01</span>
    </div>
  </div>
</section>