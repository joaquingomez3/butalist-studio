---
import { sectors } from "../data/trust";
---

<section class="border-y border-rule bg-bg-soft" aria-label="Qué tipo de producto construimos">
  <div
    class="container-fx flex flex-col gap-4 py-5 md:flex-row md:items-center md:gap-8 md:py-4"
    data-reveal
  >
    <div class="flex shrink-0 items-center gap-2">
      <span class="h-2 w-2 shrink-0 animate-pulse bg-accent" aria-hidden="true"></span>
      <span class="label">YA CONSTRUIMOS</span>
    </div>

    <ul class="flex flex-wrap gap-2" role="list">
      {
        sectors.map((s, i) => (
          <li class="group flex items-center gap-2 border border-rule-strong px-3 py-1.5 transition-colors hover:border-accent">
            <span class="mono text-[10px] text-ink-faint transition-colors group-hover:text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="mono text-[11px] uppercase tracking-[0.12em] text-ink-soft transition-colors group-hover:text-accent">
              {s}
            </span>
          </li>
        ))
      }
    </ul>

    <span class="label ml-auto hidden shrink-0 lg:inline">{sectors.length} CATEGORÍAS</span>
  </div>
</section>
