  spark: '<path d="M12 2v6m0 8v6M4.2 6.2l4.3 4.3m7 7l4.3 4.3M2 12h6m8 0h6M6.2 17.8l4.3-4.3m7-7l4.3-4.3" />',
  minus: '<path d="M5 12h14" />',
  plus: '<path d="M12 5v14M5 12h14" />',
};

const isFilled = name === "github" || name === "twitter" || name === "instagram";
---

{
  isFilled ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class={className}
      aria-hidden="true"
      set:html={paths[name] ?? ""}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
      set:html={paths[name] ?? ""}
    />
  )
}