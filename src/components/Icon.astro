  twitter: '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17-18 11.7 2.8.1 5.5-1 6.6-2.5-2-.2-3.6-1.7-4-3.4.5.1 1 .1 1.4-.1-2-.6-3.6-2.6-3.4-4.9.6.3 1.2.6 1.8.6-1.5-1.2-2.4-3.2-1.4-5.4 2.2 2.7 5.5 4.3 9 4.5a5.3 5.3 0 0 1 2.4-5.6 4.4 4.4 0 0 1 4.4 1c1-.3 2-.6 2.9-1-.2 1-1 1.7-2 2.2 1-.1 1.9-.4 2.8-.7z" />',
