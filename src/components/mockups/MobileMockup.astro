---
interface Props {
  class?: string;
}
const { class: className = "w-full" } = Astro.props;
---

<div class={`flex justify-center ${className}`}>
  <div class="w-40 border-2 border-ink/70 rounded-[1.5rem] p-2 bg-bg-raised">
    <div class="flex h-3 w-16 items-center justify-center rounded-full bg-ink/20">
      <div class="h-1 w-8 rounded-full bg-ink/40"></div>
    </div>
    <div class="mt-3 space-y-1.5 border border-rule p-2">
      <div class="h-3 w-3/4 rounded-sm bg-accent/70"></div>
      <div class="h-2 w-full bg-ink-faint/25"></div>
      <div class="h-2 w-full bg-ink-faint/25"></div>
      <div class="h-2 w-1/2 bg-ink-faint/25"></div>
      <div class="mt-2 flex gap-2">
        <div class="h-6 flex-1 rounded-sm bg-accent/60"></div>
        <div class="h-6 flex-1 rounded-sm bg-ink-faint/25"></div>
      </div>
    </div>
    <div class="mt-2 grid grid-cols-4 gap-1.5">
      {[0, 1, 2, 3].map((i) => (
        <span class={`h-3 rounded-sm ${i === 0 ? "bg-accent" : "bg-ink-faint/30"}`}></span>
      ))}
    </div>
  </div>
</div>