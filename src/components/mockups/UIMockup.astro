---
interface Props {
  class?: string;
}
const { class: className = "w-full" } = Astro.props;
---

<div class={`border border-rule bg-bg-raised ${className}`}>
  <div class="flex items-center gap-2 border-b border-rule px-3 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
    <div class="ml-1 h-3 flex-1 rounded-sm bg-ink-faint/20"></div>
    <div class="h-3 w-10 rounded-sm bg-ink-faint/20"></div>
  </div>
  <div class="flex">
    <div class="hidden w-1/4 flex-col gap-2 border-r border-rule p-3 sm:flex">
      <div class="h-2 w-3/4 bg-accent/50"></div>
      <div class="h-2 w-full bg-ink-faint/25"></div>
      <div class="h-2 w-full bg-ink-faint/25"></div>
      <div class="h-2 w-2/3 bg-ink-faint/25"></div>
      <div class="h-2 w-3/4 bg-ink-faint/15"></div>
    </div>
    <div class="flex-1 space-y-3 p-4">
      <div class="flex items-center justify-between gap-2">
        <div class="h-4 w-24 rounded-sm bg-ink/80"></div>
        <div class="h-3 w-16 rounded-sm bg-accent/60"></div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {[0, 1, 2].map((i) => (
          <div class="space-y-2 border border-rule p-3">
            <div class="h-2 w-2/3 bg-ink-faint/30"></div>
            <div class={`h-5 w-full rounded-sm ${i === 0 ? "bg-accent/40" : "bg-ink-faint/25"}`}></div>
            <div class="h-2 w-1/2 bg-ink-faint/20"></div>
          </div>
        ))}
      </div>
      <div class="h-3 w-2/3 rounded-sm bg-ink-faint/20"></div>
      <div class="h-3 w-1/2 rounded-sm bg-ink-faint/15"></div>
    </div>
  </div>
</div>