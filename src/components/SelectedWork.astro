---
import { projects } from "../data/projects";
import SectionHeader from "./SectionHeader.astro";
import TerminalMockup from "./mockups/TerminalMockup.astro";
import UIMockup from "./mockups/UIMockup.astro";
import GraphMockup from "./mockups/GraphMockup.astro";
import CodeMockup from "./mockups/CodeMockup.astro";
import MobileMockup from "./mockups/MobileMockup.astro";

const mockups = {
  terminal: TerminalMockup,
  ui: UIMockup,
  graph: GraphMockup,
  code: CodeMockup,
  mobile: MobileMockup,
};
---

<section id="work" class="py-16 sm:py-24 md:pb-36 md:pt-24">
  <SectionHeader
    num="§02"
    label="TRABAJO / SAAS"
    title="Trabajo seleccionado"
    desc="Software a medida entregado y productos propios en camino. Cada pieza tiene dueño y dirección clara."
    monoTag="02 / INDEX"
  />

  <div class="container-fx mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((p) => {
        const Comp = mockups[p.mockup];
        return (
          <a
            href={p.href}
            class="group flex min-w-0 flex-col overflow-hidden border border-rule bg-bg-raised transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-accent hover:shadow-[6px_6px_0_0_var(--color-accent)]"
            data-reveal
          >
            <div class="relative border-b border-rule overflow-hidden">
              <div class="px-5 pb-5 pt-12">
                <Comp class="aspect-[4/3] w-full" />
              </div>
              <span class="absolute left-0 top-3 bg-accent px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-accent-ink">
                {p.type}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-baseline justify-between">
                <span class="font-mono text-[11px] text-ink-faint">{p.index}</span>
                <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">
                  {p.status}
                </span>
              </div>
              <h3 class="mt-3 font-display text-2xl font-bold transition-colors group-hover:text-accent">
                {p.title}
              </h3>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wide text-ink-faint">
                {p.tag}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{p.description}</p>
              <span class="mt-5 flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-accent opacity-0 transition-opacity group-hover:opacity-100">
                Ver caso → 
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</section>