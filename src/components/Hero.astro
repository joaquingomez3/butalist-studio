---
import { site } from "../data/site";
---

<section id="top" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image:
    linear-gradient(to right, var(--color-rule) 1px, transparent 1px),
    linear-gradient(to bottom, var(--color-rule) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 90%);
  " aria-hidden="true"></div>

  <div class="container-fx relative pb-8 pt-16 md:pb-12 md:pt-24">
    <div class="mb-10 flex items-center justify-between md:mb-14" data-reveal>
      <span class="label-accent">(01_031)</span>
      <span class="label hidden sm:inline">ESTUDIO DE SOFTWARE</span>
      <span class="label">{site.location}</span>
    </div>

    <h1 class="h-display text-[clamp(2.5rem,12.5vw,10.5rem)] uppercase" data-line-mask>
      <span class="line-mask"><span class="line-i">Construimos</span></span>
      <span class="line-mask"><span class="line-i"><span class="text-outline">software</span></span></span>
      <span class="line-mask"><span class="line-i">a medida<span class="text-accent">.</span></span></span>
    </h1>
  </div>

  <div class="container-fx relative pb-12 md:pb-16">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-md" data-reveal>
        <p class="text-lg leading-relaxed text-ink-soft">
          Estudio independiente de desarrollo. Software a medida y SaaS.
          Dos desarrolladores, formación universitaria, código serio.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4" data-reveal>
        <a href="#contacto" class="btn-force">Empezar un proyecto</a>
        <a href="#work" class="btn-ghost-brutal">Ver trabajo</a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 border-y border-rule md:grid-cols-4">
    <div class="flex items-center gap-2 border-b border-r border-rule p-4 md:border-b-0">
      <span class="mono text-[11px] text-ink-faint">[est]</span>
      <span class="mono text-[11px]">{site.foundedYear}</span>
    </div>
    <div class="flex items-center gap-2 border-b border-rule p-4 md:border-b-0 md:border-r">
      <span class="mono text-[11px] text-ink-faint">[team]</span>
      <span class="mono text-[11px]">02 devs</span>
    </div>
    <div class="flex items-center gap-2 border-r border-rule p-4">
      <span class="mono text-[11px] text-ink-faint">[status]</span>
      <span class="mono text-[11px] text-accent">{site.status}</span>
    </div>
    <div class="flex items-center gap-2 p-4">
      <span class="mono text-[11px] text-ink-faint">[scroll]</span>
      <span class="mono text-[11px] animate-pulse">▼</span>
    </div>
  </div>
</section>