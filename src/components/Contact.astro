---
import { site } from "../data/site";

const socials = [
  { key: "instagram", label: "INSTAGRAM", detail: "@binariodevlabs", href: site.social.instagram },
  { key: "whatsapp", label: "WHATSAPP", detail: site.social.whatsappLabel, href: site.social.whatsapp },
];
---

<section id="contacto" class="pb-16 pt-10 sm:pb-24 sm:pt-14 md:pb-36 md:pt-14">
  <div class="container-fx text-center">
    <div class="t-rule flex items-center justify-between pb-4 pt-6" data-reveal>
      <span class="label-accent">§06 / CONTACTO</span>
      <span class="label hidden sm:inline">RESPONDEMOS EN 24H</span>
    </div>

    <h2 class="h-display mt-12 text-[clamp(2.5rem,14vw,12rem)] uppercase" data-line-mask>
      <span class="line-mask"><span class="line-i">Hablemos<span class="text-accent">.</span></span></span>
    </h2>

    <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-ink-soft" data-reveal>
      Contanos qué necesitás. Sin tecnicismos, sin compromiso inicial. Si lo
      vemos viable, te lo decimos; y si no, también.
    </p>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-4" data-reveal>
      <a href={`mailto:${site.email}`} class="btn-force">Escribinos</a>
      <a href={`mailto:${site.email}`} class="link-force max-w-full font-display text-[clamp(1.05rem,5.4vw,1.5rem)] font-bold sm:text-3xl" data-magnetic>
        {site.email}
      </a>
    </div>
  </div>



  <div class="container-fx mt-20">
    <div class="t-rule grid border-x border-rule sm:grid-cols-2" data-reveal>
      {socials.map((s) => (
        <a
          href={s.href || undefined}
          class:list={[
            "group flex items-center justify-between gap-3 border-b border-rule px-5 py-6 transition-colors hover:bg-accent hover:text-accent-ink sm:border-r sm:last:border-r-0",
          ]}
          {...(s.href ? { target: "_blank", rel: "noreferrer" } : {})}
        >
          <span class="flex items-center gap-3">
            <span class="font-mono text-[11px] text-ink-faint transition-colors group-hover:text-accent-ink/70">/{s.key}</span>
            <span class="flex flex-col gap-1">
              <span class="font-mono text-sm font-semibold uppercase tracking-widest">{s.label}</span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-ink-faint transition-colors group-hover:text-accent-ink/70">{s.detail}</span>
            </span>
          </span>
          <span class="font-mono">{s.href ? "↗" : "—"}</span>
        </a>
      ))}
    </div>
  </div>


</section>
